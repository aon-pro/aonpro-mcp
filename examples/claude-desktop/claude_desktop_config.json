{
  "mcpServers": {
    "aon": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api.aon.pro/v1/mcp",
        "--header",
        "X-AON-Placement-Id:${AON_PLACEMENT_ID}"
      ],
      "env": {
        "AON_PLACEMENT_ID": "YOUR_AON_PLACEMENT_ID"
      }
    }
  }
}
